<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo</title>
</head>
<body>
    <section class="catalogo">
        <% prods.ForEach(prod => { %>
            <h3> <%= prods.nombre %></h3>
            <p> <%= prods.precio %></p>
        <% }) %>
    </section>
</body>
</html>
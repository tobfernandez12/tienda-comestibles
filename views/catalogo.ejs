<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/png" href="../public/assets/EJS-MARKET-logo.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de productos</title>
    <link rel="stylesheet" href="/css/catalogo.css">
    <script src="https://code.iconify.design/iconify-icon/3.0.3/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="barra">
        <img class="logo" src="/assets/EJS-MARKET-logo.png" alt="Logo">
        <a class="barra-a" href="/">Inicio</a>
        <a class="barra-a" href="">Ofertas Relámpago</a>
        <a class="barra-a" href="">¿Quiénes somos?</a>
        <a class="barra-a" href="">Contacto</a>
        <a class="barra-a" href="/admin">Admin</a>
    </div>   
    <div class="catalogo-productos">
        <h2 class="catalogo-title">Catálogo de productos</h2>
    </div>
    <form action="/catalogo" method="GET" class="busqueda" id="form-busqueda">

    <i class="bi bi-search"></i>

    <div class="contenedor-input">
        <input class="barra-busqueda" type="text" id="buscar-productos" name="buscar"
        placeholder="Buscar productos..."
        value="<%= buscar || '' %>"
        autocomplete="off">

        <div id="sugerencias" class="sugerencias"></div>
    </div>

    <button type="submit" class="boton-buscar">Buscar</button>

</form>
    <ul class="product-grid">
        <% prods.forEach((prod, i) => { %>
            <li class="product-card" style="--i: <%= i %>">
                <img class="product-image" src="<%= prod.imagen %>" alt="<%= prod.nombre %>" loading="lazy">
                <h2><%= prod.nombre %></h2>
                <h4><%= prod.marca %></h4>
                <h2>$<%= prod.precio %></h2>
                <p class="stock">Stock: <%= prod.stock %></p>
                <a class="boton" href="/productos/<%= prod.id %>">Ver detalles</a>
            </li>
        <% }) %>
    </ul>

    <script>
    const input = document.getElementById("buscar-productos");
    const sugerencias = document.getElementById("sugerencias");

    let temporizador;

    input.addEventListener("input", () => {
        clearTimeout(temporizador);

        const texto = input.value.trim();

        if (texto.length < 2) {
            sugerencias.innerHTML = "";
            sugerencias.style.display = "none";
            return;
        }

        temporizador = setTimeout(async () => {
            try {
                const respuesta = await fetch(
                    `/productos/buscar/sugerencias?buscar=${encodeURIComponent(texto)}`
                );

                const productos = await respuesta.json();

                sugerencias.innerHTML = "";

                if (productos.length === 0) {
                    sugerencias.innerHTML =
                        '<p class="sin-resultados">No se encontraron productos</p>';
                } else {
                    productos.forEach(producto => {
                        const enlace = document.createElement("a");

                        enlace.href = `/productos/${producto.id}`;
                        enlace.className = "sugerencia";

                        const imagen = document.createElement("img");
                        imagen.src = producto.imagen || "/assets/EJS-MARKET-logo.png";
                        imagen.alt = producto.nombre;

                        const informacion = document.createElement("div");

                        const nombre = document.createElement("strong");
                        nombre.textContent = producto.nombre;

                        const marca = document.createElement("span");
                        marca.textContent = producto.marca;

                        const precio = document.createElement("span");
                        precio.textContent = "$" + Number(producto.precio).toLocaleString("es-AR");

                        informacion.append(nombre, marca, precio);
                        enlace.append(imagen, informacion);

                        sugerencias.appendChild(enlace);
                    });
                }

                sugerencias.style.display = "block";

            } catch (error) {
                console.error("Error al buscar sugerencias:", error);
            }

        }, 250);
    });

    document.addEventListener("click", (evento) => {
        if (!evento.target.closest(".busqueda")) {
            sugerencias.style.display = "none";
        }
    });

    input.addEventListener("focus", () => {
        if (input.value.trim().length >= 2 && sugerencias.children.length > 0) {
            sugerencias.style.display = "block";
        }
    });
</script>

</body>
</html>
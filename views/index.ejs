    <div class="iconos">
        <div>
            <span class="icono">&#xF5EA;</span>
            <h3 class="text-icon">Envíos a todo el país</h3>
            <p class="text-icon-p">Rápido y seguro</p>
        </div>
        <div>
            <span class="icono">&#xF531;</span>
            <h3 class="text-icon">Compra Segura</h3>
            <p class="text-icon-p">Tus datos protegidos</p>
        </div>
        <div>
            <span class="icono">&#xF414;</span>
            <h3 class="text-icon">Atención Personalizada</h3>
            <p class="text-icon-p">Estamos para ayudarte</p>
        </div>
    </div>
    <script src="https://iconify.design"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    <link class="logo-inicio" rel="icon" type="image/png" href="/assets/EJS-MARKET-logo.png">
    <link rel="stylesheet" href="../css/index.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title>Inicio</title>
</head>
<body>
    <div class="barra">
        <img class="logo" src="/assets/EJS-MARKET-logo.png" alt="Logo">
        <a class="barra-a" href="/admin">Admin</a>
    </div>    
    <div class="portada">
        <h1>Bienvenidos a mi tienda</h1>
        <h2>Productos de calidad, al mejor precio.</h2>
        <a class="boton" href="/catalogo">Ver catálogo</a>

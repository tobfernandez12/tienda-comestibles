<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/admin.css">
    <title>Admin</title>
</head>
<body>
    <header>
        <h1>🛒 Mi Tienda</h1>
        <a href="/">Inicio</a>
        <a href="/catalogo">Catalogo</a>
    </header>

    <section>
        <h1>Administracion de productos</h1>
        <button type="button" id="abrir-modal">+ Nuevo producto</button>
        
        <dialog id="modal-producto">
            <form action="/productos/agregar" method="POST" enctype="multipart/form-data">
                <h2>Nuevo producto</h2>
                
                <p>
                    <label for="nombre">Nombre *</label><br>
                    <input id="nombre" name="nombre" type="text" placeholder="Ingrese el nombre del producto" required>
                </p>
                
                <p>
                    <label for="marca">Marca *</label><br>
                    <input id="marca" name="marca" type="text" placeholder="Ingrese la marca" required>
                </p>
                
                <div style="display: flex; flex-wrap: wrap; gap: 16px;">
                    <p>
                        <label for="precio">Precio *</label><br>
                        <input id="precio" name="precio" type="number" min="0" step="0.01" required>
                    </p>
                    
                    <p>
                        <label for="stock">Stock *</label><br>
                        <input id="stock" name="stock" type="number" min="0" step="1" required>
                    </p>
                </div>

                <p>
                    <label for="imagen">Imagen del producto</label>
                    <br>
                    <input id="imagen" name="imagen" type="file" accept="image/jpeg,image/png,image/webp">
                </p>

                <div>
                    <button type="submit">Guardar</button>
                    <button type="button" id="cerrar-modal">Cancelar</button>
                </div>
            </form>
        </dialog>

        <div>
            <table border="1">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Stock</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                   <% prods.forEach( (producto) => { %>
                    
                      <tr>
                        <td> <%= producto.nombre %> </td>
                        <td> <%=producto.marca %></td>
                        <td> <%=producto.stock %></td>
                        <td><%=producto.precio %></td>
                        <td>
                            <button type="button" class="editar-producto" 
                                data-id="<%= producto.id %>"
                                data-nombre="<%= producto.nombre %>"
                                data-marca="<%= producto.marca %>"
                                data-precio="<%= producto.precio %>"
                                data-stock="<%= producto.stock %>"
                                data-imagen="<%= producto.imagen || '' %>">
                                Editar
                            </button>

                            <dialog id="modal-editar">
                                <form id="form-editar" method="POST" enctype="multipart/form-data">
                                    <h2>Editar producto</h2>
                                    <div style="display: flex; flex-wrap: wrap; gap: 24px;">
                                        <div>
                                            <img id="editar-vista-imagen" alt="Imagen del producto" width="180" height="180" style="object-fit: contain;" hidden>
                                            <p id="editar-sin-imagen">Sin imagen</p>

                                            <div>
                                                <button type="button" id="cambiar-imagen">Cambiar imagen</button>
                                                <input id="editar-imagen" name="imagen" type="file" accept="image/jpeg,image/png,image/webp" hidden>
                                            </div>
                                        </div>
                                        <div>
                                            <p>
                                                <label for="editar-nombre">Nombre *</label><br>
                                                <input id="editar-nombre" name="nombre" type="text" required>
                                            </p>
                                            <p>
                                                <label for="editar-marca">Marca *</label><br>
                                                <input id="editar-marca" name="marca" type="text" required>
                                            </p>
                                            <p>
                                                <label for="editar-precio">Precio *</label>
                                                <br>
                                                <input id="editar-precio" name="precio" type="number" min="0" step="0.01" required>
                                            </p>
                                            <p>
                                                <label for="editar-stock">Stock *</label>
                                                <br>
                                                <input id="editar-stock" name="stock" type="number" min="0" step="1" required>
                                            </p>
                                        </div>
                                    </div>
                                    <div>
                                        <button type="submit">Guardar cambios</button>
                                        <button type="button" id="cancelar-edicion">Cancelar</button>
                                    </div>
                                </form>
                            </dialog>

                            <form action="/productos/<%= producto.id %>/eliminar" method="POST" 
                                  onsubmit="return confirm('¿Querés eliminar este producto?')">
                                <button type="submit">Eliminar</button>
                            </form>
                        </td>
                      </tr>
                  <% }) %>
                </tbody>
            </table>
        </div>
    </section>
    <script src="/js/admin.js"></script>
</body>
</html>